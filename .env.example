# Plantilla de variables de entorno para CobrasAsistIA.
# Copia este archivo como `.env` y reemplaza el valor con tu API key real.
# El archivo `.env` está ignorado por git (ver .gitignore).

# API key del modelo Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=tu_api_key_aqui

# (Opcional) Configuración de Supabase para una iteración futura.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
